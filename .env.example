# Amazon LWA application (shared by both servers).
# Get these from Seller Central → Developer (Apps & Credentials).
#
# Do not set user identity here (refresh tokens, SELLER_ID, MARKETPLACE_ID,
# ADS_PROFILE_ID). Those come from Login with Amazon when a client connects.
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LWA_CLIENT_SECRET=amzn1.oa2-cs.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public URL MCP clients use. Required.
# Register {MCP_SERVER_URL}/oauth/amazon/callback on the LWA / SP-API application.
MCP_SERVER_URL=http://localhost:3000
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000

# Optional: extra Host header values besides MCP_SERVER_URL's host
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: override Amazon callback URL
# (default {MCP_SERVER_URL origin}/oauth/amazon/callback)
# LWA_REDIRECT_URI=http://localhost:3000/oauth/amazon/callback

# Draft SP-API apps need version=beta on the consent URL (default true).
# Set false for a published app.
# LWA_CONSENT_DRAFT=true

# Optional: Seller Central application id if it differs from LWA_CLIENT_ID
# SP_API_APPLICATION_ID=amzn1.sellerapps.app.xxxxxxxx

# Optional: Seller Central consent URL (default is NA amazon.com)
# EU:  https://sellercentral-europe.amazon.com/apps/authorize/consent
# FE:  https://sellercentral.amazon.co.jp/apps/authorize/consent
# SELLER_CENTRAL_URL=https://sellercentral-europe.amazon.com/apps/authorize/consent

# Optional API endpoint / region overrides
# SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# ADS_API_REGION=na
# ADS_API_ENDPOINT=https://advertising-api.amazon.com
